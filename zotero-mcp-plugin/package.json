{
  "name": "zotero-mcp-plus",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero MCP Plus",
  "config": {
    "addonName": "Zotero MCP Plus",
    "addonID": "{8c2b53b8-6a58-4fc1-b20f-07612fce0a77}",
    "addonRef": "zotero-mcp-plus",
    "addonInstance": "ZoteroMCPPlus",
    "prefsPrefix": "extensions.zotero.zotero-mcp-plus"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asuka123456789/zotero-mcp-plus.git"
  },
  "author": "cookjohn",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare-release": "node scripts/prepare-release.js",
    "release:init": "node scripts/init-release.js",
    "test": "node scripts/test-isolated.mjs",
    "test:integration": "node scripts/test-isolated.mjs",
    "test:unit": "mocha",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "eslint": "^9.32.0",
    "mocha": "12.0.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "0.9.2",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
